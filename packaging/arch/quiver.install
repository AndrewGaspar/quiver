post_install() {
  cat <<'EOF'
==> Quiver is installed in /usr/bin. If ~/.local/bin has quiver, quiverd, quiver-app or ubi
    (an older per-user or dev install), they come first on PATH; remove them, or uninstall
    with tools/install-user.sh --uninstall.
==> A quiverd already running keeps its old build; restart it when no game is running:
    quiver daemon stop   (any quiver command starts the new one)
==> The groups and udev rules for game controllers are installed. Firewall profiles are
    installed but allow nothing: to let Moonlight clients and your other machines in from
    your LAN and tailnet only, run  quiver system setup --firewall lan,tailnet
    (quiver system setup --check lists what's set up).
EOF
}

post_upgrade() {
  cat <<'EOF'
==> quiverd restarts onto this build by itself once no game, job, perf subscription or
    hold needs it (quiver daemon status says what it waits on). quiver-app relaunches itself.
EOF
}
