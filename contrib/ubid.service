# systemd user unit for the launcher daemon. Install with:
#   cp ubid.service ~/.config/systemd/user/ && systemctl --user enable --now ubid
# Games inherit this service's environment, so the session's display variables must be
# imported into the user manager (most compositors do; otherwise run
# `systemctl --user import-environment WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP`).
[Unit]
Description=Ubisoft launcher daemon (ubid)
After=graphical-session.target
PartOf=graphical-session.target

[Service]
ExecStart=%h/.local/bin/ubid
Restart=on-failure

[Install]
WantedBy=graphical-session.target
