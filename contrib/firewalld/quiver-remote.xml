<?xml version="1.0" encoding="utf-8"?>
<!-- quiver-firewalld service v1 (design/INSTALL.md). Allow it from your LAN and tailnet only:
     `quiver system setup --firewall lan,tailnet` adds rich rules with a source address. -->
<service>
  <short>Quiver Remote</short>
  <description>Other Quiver machines: the control connection and each stream's media port, counting up from 47998.</description>
  <port protocol="tcp" port="47990"/>
  <port protocol="udp" port="47998-48061"/>
</service>
